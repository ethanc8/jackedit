class ArrayUtils {
  /// Inserts item at index index of the array arr, pushing back the other items.
  function void insert(Array arr, int arrLength, int index, int item) {
    var int i;

    // First push back the other items, going from last to first.
    let i = arrLength;
    while(i > index) {
      let arr[i] = arr[i - 1];
      let i = i - 1;
    }

    // Then insert the new item
    let arr[index] = item;
    return;
  }

  /// Removes item at index index of the array arr, pulling forward the other items.
  function void remove(Array arr, int arrLength, int index) {
    var int i;

    // Pull forward the other items, going from first to last.
    let i = index;
    while(i < arrLength) {
      let arr[i] = arr[i + 1];
      let i = i + 1;
    }

    return;
  }

  /// Appends b to the end of a.
  function void append(Array a, int aLen, Array b, int bLen) {
    var int i;

    let i = aLen;
    while(i < bLen) {
      let a[i] = a[i + 1];
      let i = i + 1;
    }

    return;
  }
}