class Program {
  field char CHAR_BACKSPACE;
  field char CHAR_ENTER;

  field char CHAR_LEFT;
  field char CHAR_RIGHT;
  field char CHAR_UP;
  field char CHAR_DOWN;

  field char CHAR_PIPE;
  field char CHAR_SPACE;
  field char CURSOR_CHAR;

  field int LINE_PREAMBLE_LENGTH;

  field int ALLOWABLE_LINES;
  field int MAX_LINE_LENGTH;

  field int column;
  field int screenRowOffset;
  field int lineNo;
  field int numLines;

  field Array lines;
  field Array lineLengths;

  constructor Program new() {
    let CHAR_BACKSPACE = 129;
    let CHAR_ENTER = 128;

    let CHAR_PIPE = 124;
    let CHAR_SPACE = 32;
    let CURSOR_CHAR = 0;

    let CHAR_LEFT = 130;
    let CHAR_RIGHT = 132;
    let CHAR_UP = 131;
    let CHAR_DOWN = 133;

    let LINE_PREAMBLE_LENGTH = 4;
    let ALLOWABLE_LINES = 23;
    let MAX_LINE_LENGTH = 60; // 64 chars wide; 4 for the line number/gutter

    return this;
  }

  // https://github.com/nand2tetris/nand2tetris_simulator/blob/327b7e4337b31efb815e1c1e3913c0efd299bcf2/BuiltInVMCodeSource/Keyboard.java#L53
  method char waitKey() {
    var char current;
    var char saved;
    let current = 0;
    let saved = 0;

    while(saved = 0 | ~(current = 0)) {
      do Sys.wait(1); // millisecond
      let current = Keyboard.keyPressed();
      if(~(current = 0)) {
        let saved = current;
      }
    }
    return saved;
  }

  /// Initializes a line with its line number
  method void initLine(int screenRowOffset, int lineNo) {
    do Output.moveCursor(lineNo + screenRowOffset, 0);
    do Output.printInt(lineNo);
    return;
  }

  method void writeLine(int row, Array line, int lineLength) {
    var int i;

    // do Output.moveCursor(row, LINE_PREAMBLE_LENGTH);

    let i = 0;
    while(i < lineLength) {
      do Output.moveCursor(row, i + LINE_PREAMBLE_LENGTH);
      do Output.printChar(line[i]);
      let i = i + 1;
    }
    while(i < MAX_LINE_LENGTH) {
      do Output.moveCursor(row, i + LINE_PREAMBLE_LENGTH);
      do Output.printChar(CHAR_SPACE);
      let i = i + 1;
    }

    return;
  }

  method void writeEmptyLine(int row) {
    var int i;

    let i = 0;
    while(i < MAX_LINE_LENGTH) {
      do Output.moveCursor(row, i);
      do Output.printChar(CHAR_SPACE);
      let i = i + 1;
    }

    return;
  }

  method void redrawFile() {
    var int i;

    let i = 0;
    while(i < numLines) {
      do initLine(screenRowOffset, i);
      do writeLine(i + screenRowOffset, lines[i], lineLengths[i]);
      let i = i + 1;
    }
    while(i < ALLOWABLE_LINES) {
      do writeEmptyLine(i + screenRowOffset);
      let i = i + 1;
    }
    return;
  }

  method void main() {
    // temp variables used later on
    var char key;
    var int i;
    var int j;
    var int len;
    var Array line;
    var int second_line;

    // begin actual code
    let lines = Array.new(ALLOWABLE_LINES);
    let lineLengths = Array.new(ALLOWABLE_LINES);
    let numLines = 1;

    let i = 0;
    while(i < ALLOWABLE_LINES) {
      let lines[i] = Array.new(MAX_LINE_LENGTH);
      let lineLengths[i] = 0;

      // // Initialize the line to be all-spaces
      // let line = lines[i];
      // let j = 0;
      // while(j < MAX_LINE_LENGTH) {
      //   let line[j] = CHAR_SPACE;
      // }

      let i = i + 1;
    }
    
    // Column, lineNo + screenRowOffset always represent the position of the user cursor "|"
    let column = 0;
    let screenRowOffset = 0;
    let lineNo = 0;

    do initLine(screenRowOffset, lineNo);

    while(true) {
      let key = waitKey();
      if(key = CHAR_BACKSPACE) {
        // Following the standard convention, backspace acts as if the cursor was to the left of the current char
        if(column > 0) {
          // Remove the character from the string data
          do ArrayUtils.remove(line, lineLengths[lineNo], column - 1);

          let column = column - 1;
          let lineLengths[lineNo] = lineLengths[lineNo] - 1;

          // Redraw the file
          do redrawFile();

          // Move the Output cursor backwards and draw the user-cursor
          do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
          do Output.printChar(CURSOR_CHAR);
        } else {
          if(lineNo > 0) {
            // Add the line's contents to the previous line
            do ArrayUtils.append(
              lines[lineNo - 1], lineLengths[lineNo - 1],
              lines[lineNo], lineLengths[lineNo]);
            let lineLengths[lineNo - 1] = lineLengths[lineNo - 1] + lineLengths[lineNo];
            // Remove the line
            do ArrayUtils.remove(lines, numLines, lineNo);
            do ArrayUtils.remove(lineLengths, numLines, lineNo);

            let numLines = numLines - 1;
            let lineNo = lineNo - 1;

            // Redraw the file
            do redrawFile();

            // Place the cursor at the end of the previous line (which number is now lineNo)
            let column = lineLengths[lineNo];
            do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
            do Output.printChar(CURSOR_CHAR);
          }
        }
      }
      if(key = CHAR_ENTER) {
        // Clear the current cursor
        do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
        let line = lines[lineNo];
        if(column < lineLengths[lineNo]) {
          do Output.printChar(line[column]);
        } else {
          do Output.printChar(CHAR_SPACE);
        }

        // Split the current line
        let len = lineLengths[lineNo];
        let line = lines[lineNo];
        let lineLengths[lineNo] = column;
        let second_line = line + column;
        do ArrayUtils.insert(lineLengths, numLines, lineNo + 1, len - column);
        do ArrayUtils.insert(lines, numLines, lineNo + 1, second_line);

        let numLines = numLines + 1;
        // Redraw the file
        do redrawFile();

        let lineNo = lineNo + 1;
        let column = 0;
      } 
      if(key = CHAR_LEFT) {
        if(column > 0) {
          // Clear the current cursor
          do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
          let line = lines[lineNo];
          if(column < lineLengths[lineNo]) {
            do Output.printChar(line[column]);
          } else {
            do Output.printChar(CHAR_SPACE);
          }

          // Move the cursor
          let column = column - 1;
          do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
          do Output.printChar(CURSOR_CHAR);
        }
      }
      if(key = CHAR_RIGHT) {
        do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
        let line = lines[lineNo];
        if(column < lineLengths[lineNo]) {
          do Output.printChar(line[column]);
          let column = column + 1;
          do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
          do Output.printChar(CURSOR_CHAR);
        }
      }
      if(key = CHAR_UP) {
        if(lineNo > 0) {
          // Clear the current cursor
          do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
          let line = lines[lineNo];
          if(column < lineLengths[lineNo]) {
            do Output.printChar(line[column]);
          } else {
            do Output.printChar(CHAR_SPACE);
          }

          // Move the cursor
          let lineNo = lineNo - 1;
          let line = lines[lineNo];
          if(column > lineLengths[lineNo]) {
            let column = lineLengths[lineNo];
          }
          do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
          do Output.printChar(CURSOR_CHAR);
        }
      }
      if(key = CHAR_DOWN) {
        // Clear the current cursor
        do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
        let line = lines[lineNo];
        if(column < lineLengths[lineNo]) {
          do Output.printChar(line[column]);
        } else {
          do Output.printChar(CHAR_SPACE);
        }

        // Move the cursor
        let lineNo = lineNo + 1;
        let line = lines[lineNo];
        if(column > lineLengths[lineNo]) {
          let column = lineLengths[lineNo];
        }
        do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
        do Output.printChar(CURSOR_CHAR);
      }
      // Printable chars
      if((key > 31) & (key < 127)) {
        if(lineLengths[lineNo] < MAX_LINE_LENGTH) {
          let line = lines[lineNo];
          let line[column] = key;

          let column = column + 1;
          let lineLengths[lineNo] = lineLengths[lineNo] + 1;

          // Redraw the file
          do redrawFile();

          do Output.moveCursor(lineNo + screenRowOffset, column + LINE_PREAMBLE_LENGTH);
          do Output.printChar(CURSOR_CHAR);
        }
      }
    }
    return;
  }
}